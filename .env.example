FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DATABASE_URL=sqlite:///stocksense.db
LOGIN_RATE_LIMIT=5
DEMO_STORE_NAME="Metro Express Retail"
DEMO_USER_EMAIL=demo@stocksense.local
DEMO_USER_PASSWORD=StockSenseDemo2026!

# Optional OpenAI-compatible Copilot. Leave the API key unset for fully local operation.
COPILOT_API_KEY=
COPILOT_API_BASE_URL=https://api.openai.com/v1
COPILOT_MODEL=gpt-4o-mini
